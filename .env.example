# Environment Configuration for BizFlow ERP

# PostgreSQL Database (Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizflow_erp?schema=public"

# Backend API Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="bizflow_jwt_access_secret_change_me_in_prod"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="bizflow_jwt_refresh_secret_change_me_in_prod"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
