# Environment Configuration for BizFlow ERP

# PostgreSQL Database (Supabase PostgreSQL Connection String)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.lywytpgqmpqqucoaontq.supabase.co:5432/postgres"

# Supabase Server Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Frontend Supabase Config
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Backend API Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="bizflow_jwt_access_secret_change_me_in_prod"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="bizflow_jwt_refresh_secret_change_me_in_prod"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
